<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>OpenXml.Wrappers</RootNamespace>
    <AssemblyName>OpenXml.Wrappers</AssemblyName>
    <PackageId>E2e4.OpenXml.Wrappers</PackageId>
    <Title>E2e4 OpenXml Wrappers</Title>
    <AssemblyTitle>E2e4 OpenXml Wrappers</AssemblyTitle>
    <Description>A Word-object-model-like API (Range, Paragraphs, Tables, Bookmarks, Comments, Fields, Sections, Styles and more) over the Open XML SDK, so that code for .docx files reads like the Word VBA macros it replaces.</Description>
    <PackageTags>openxml;word;wordprocessingml;docx;office;document;vba</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OpenXml.Wrappers.Test" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- nuget.org renders neither raw HTML nor relative paths, and shows images only from allowed hosts (raw.githubusercontent.com is one).
       The packed README is a copy whose icon <img> is a Markdown image on a raw URL pinned to the release tag, and whose repo-relative links are
       absolute links to that tag (GitHub keeps the original). -->
  <Target Name="PackReadme" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <PropertyGroup>
      <RepoBlob>https://github.com/th3snark/E2e4.OpenXml.Wrappers/blob/v$(Version)/</RepoBlob>
      <RepoRaw>https://raw.githubusercontent.com/th3snark/E2e4.OpenXml.Wrappers/v$(Version)/</RepoRaw>
      <PackedReadme>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)nuget/README.md</PackedReadme>
      <PackedReadmeText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../README.md'))</PackedReadmeText>
      <PackedReadmeText>$([System.Text.RegularExpressions.Regex]::Replace('$(PackedReadmeText)', '(?m)^&lt;img src="([^"]+)" alt="([^"]*)"[^
]*', '![$2]($(RepoRaw)$1)'))</PackedReadmeText>
      <PackedReadmeText>$([System.Text.RegularExpressions.Regex]::Replace('$(PackedReadmeText)', '\]\((?!https?:|#)([^)]+)\)', ']($(RepoBlob)$1)'))</PackedReadmeText>
    </PropertyGroup>
    <WriteLinesToFile File="$(PackedReadme)" Lines="$([MSBuild]::Escape('$(PackedReadmeText)'))" Overwrite="true" />
    <ItemGroup>
      <None Include="$(PackedReadme)" Pack="true" PackagePath="\" />
    </ItemGroup>
  </Target>

</Project>
