<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OpenXml.Wrappers</RootNamespace>
    <AssemblyName>OpenXml.Wrappers</AssemblyName>
    <Title>E2e4 OpenXml Wrappers</Title>
    <Description>Word-object-model-like wrappers (Range, Paragraphs, Tables, Bookmarks, Comments) over the Open XML SDK WordprocessingML types.</Description>
    <PackageTags>openxml;word;wordprocessingml;docx</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

</Project>
