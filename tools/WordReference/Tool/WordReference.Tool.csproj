<Project Sdk="Microsoft.NET.Sdk">

  <!-- The command-line side of the Word reference harness (see ../README.md). Not part of the solution: only the scripts in ../ run it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OpenXml.Wrappers.WordReference</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\OpenXml.Wrappers\OpenXml.Wrappers.csproj" />
  </ItemGroup>

  <!-- The normaliser is the test project's, so the snapshots and the conformance test share one implementation. -->
  <ItemGroup>
    <Compile Include="..\..\..\OpenXml.Wrappers.Test\Utils\MarkupNormalizer.cs" Link="MarkupNormalizer.cs" />
  </ItemGroup>

</Project>
