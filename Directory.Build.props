<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Assembly and package identity. These become the assembly attributes (company, product, copyright, neutral language).
       The version is set in each packed project's csproj (<Version>); the SDK derives AssemblyVersion and FileVersion from it. -->
  <PropertyGroup>
    <Company>E2e4</Company>
    <Authors>E2e4</Authors>
    <Product>E2e4 OpenXml Wrappers</Product>
    <!-- A fixed year: the copyright year of a release should not change just because it was built later. -->
    <Copyright>Copyright © 2026 GitHub: th3snark (E2e4). Licensed under the MIT License.</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Repository, license and source link information shared by everything that is packed. -->
  <PropertyGroup>
    <RepositoryUrl>https://github.com/th3snark/E2e4.OpenXml.Wrappers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/th3snark/E2e4.OpenXml.Wrappers</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

</Project>
