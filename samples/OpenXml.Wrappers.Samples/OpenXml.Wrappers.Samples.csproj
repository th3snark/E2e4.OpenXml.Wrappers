<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net8.0;net48</TargetFrameworks>
    <RootNamespace>OpenXml.Wrappers.Samples</RootNamespace>
    <AssemblyName>OpenXml.Wrappers.Samples</AssemblyName>
    <IsPackable>false</IsPackable>
    <Description>Runnable examples for E2e4.OpenXml.Wrappers. Each example writes a .docx file.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OpenXml.Wrappers\OpenXml.Wrappers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\build\IsExternalInit.cs" Link="IsExternalInit.cs" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>

</Project>
